# Copy to .env and fill in real values. Never commit .env.
# See docs/architecture.md for what each service is used for.

# --- Data providers ---
POLYGON_API_KEY=
BINANCE_API_KEY=
BINANCE_API_SECRET=
COINGECKO_PRO_API_KEY=

# --- LLM endpoints (configurable per agent, see CLAUDE.md "Stack") ---
# Set the provider/model per agent in config, not here — these are just
# credentials for whichever provider(s) config points at.
MARKET_SCOUT_LLM_API_KEY=
STRATEGY_ARCHITECT_LLM_API_KEY=
BACKTEST_ENGINE_LLM_API_KEY=
RISK_COP_LLM_API_KEY=

# --- App ---
APP_ENV=development
LOG_LEVEL=info

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

