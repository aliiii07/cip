# Copy to .env.local and fill in. Never commit .env.local.
# Every key here is read server side only, inside app/api/**. None is exposed
# to the browser (no NEXT_PUBLIC_ prefix, deliberately).

# --- Anthropic (required for the Prototype narrative) ---
# Without this the dashboard still renders. Every number is computed in code,
# and the narrative falls back to a neutral, deterministic factual read.
ANTHROPIC_API_KEY=
# Optional override. Defaults to claude-sonnet-5.
CIP_ANTHROPIC_MODEL=claude-sonnet-5

# --- Market data ---
# Crypto (BTC, ETH) uses Binance's keyless public endpoint. No key needed.
# Equities (AAPL, TSLA), FX (EUR/USD, USD/JPY) and Gold (XAU/USD) prefer
# Polygon when this key is set: official, minute-accurate, paid.
# Without it, those assets fall back to Yahoo Finance's public chart endpoint,
# which needs no key and is still real, current data, not a sample. Yahoo is
# unofficial and undocumented, so it can rate-limit or change without notice;
# set POLYGON_API_KEY for production reliability. Only if both fail does an
# asset fall back to clearly-badged deterministic sample candles.
POLYGON_API_KEY=

# --- News & sentiment (optional) ---
# Headlines must be real. Without a key the news panel says so rather than
# inventing headlines.
NEWSAPI_KEY=
