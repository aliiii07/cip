# Copy to .env.local and fill in. Never commit .env.local.
# Every key here is READ SERVER-SIDE ONLY, inside app/api/**. None is exposed
# to the browser (no NEXT_PUBLIC_ prefix — that is deliberate).

# --- Anthropic (required for the Prototype narrative) ---
# Without this the dashboard still renders: every number is computed in code,
# and the narrative falls back to a neutral, deterministic factual read.
ANTHROPIC_API_KEY=
# Optional override. Defaults to claude-sonnet-5.
CIP_ANTHROPIC_MODEL=claude-sonnet-5

# --- Market data ---
# Crypto (BTC, ETH) uses Binance's keyless public endpoint — no key needed.
# Equities (AAPL, TSLA), FX (EUR/USD, USD/JPY) and Gold (XAU/USD) need Polygon.
# Absent, those assets fall back to clearly-badged deterministic sample candles.
POLYGON_API_KEY=

# --- News & sentiment (optional) ---
# Headlines must be real. Without a key the news panel says so rather than
# inventing headlines.
NEWSAPI_KEY=
