# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
env/
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
/build/

# Node / Next.js
node_modules/
# Covers any NEXT_DIST_DIR value (see frontend/next.config.mjs), not just .next
.next*/
out/
.turbo/
*.tsbuildinfo

# Vercel CLI link state — machine-local, never committed
.vercel/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Backtest / data artifacts
*.log
.cache/
data/raw/
data/processed/
*.parquet
*.duckdb
data/*.db

# Repo dumps / packs — generated, never committed
project_dump.txt
repomix-output.xml

# Editors / OS
.vscode/
.idea/
.DS_Store

